# MediVision AI Backend Environment Variables

# MongoDB Connection String (Atlas or Local)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=medivision_ai

# JWT Authentication Security Settings
SECRET_KEY=generate_a_secure_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API Key (for Grounded RAG synthesis, AI Reports, and Conversational Q&A)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL (for CORS allowance)
FRONTEND_URL=http://localhost:5173
